diff --git a/factory_finalization_core.py b/factory_finalization_core.py
new file mode 100644
index 0000000000000000000000000000000000000000..006e1e745dadc573c32fc88fad68eb3d2a297091
--- /dev/null
+++ b/factory_finalization_core.py
@@ -0,0 +1,482 @@
+"""One-start finalization for NEW private job databases only.
+
+No daemon, model, shell, task requeue, native migration or historical recovery.
+The caller must fence service admission and supply freshly verified quiescence.
+The journal is captured by SQLite triggers in the SAME commits as native task
+creation and run claims. Live writes require a per-connection function installed
+only by the sealed driver inside the bound service cgroup. Not a same-UID sandbox.
+"""
+import contextlib as fj_contextlib
+import hashlib as fj_hashlib
+import json as fj_jsonlib
+import os as fj_os
+from pathlib import Path as FjPath
+import re as fj_re
+import sqlite3 as fj_sqlite3
+import stat as fj_stat
+import time as fj_time
+
+FJ_PROTOCOL = 'one-start-finalization-v1'
+FJ_TABLE = 'sf_finalization_job'
+FJ_RUNS = 'sf_finalization_runs'
+
+
+class FjRefused(RuntimeError):
+    pass
+
+
+class FjPhaseFinished(FjRefused):
+    pass
+
+
+def fj_need(value, code):
+    if not value:
+        raise FjRefused(code)
+
+
+def fj_bytes(value):
+    return (fj_jsonlib.dumps(value, sort_keys=True, ensure_ascii=False, indent=2)+'\n').encode()
+
+
+def fj_sha(raw):
+    return fj_hashlib.sha256(raw).hexdigest()
+
+
+def fj_pairs(items):
+    out = {}
+    for key, value in items:
+        fj_need(key not in out, 'duplicate_finalization_key')
+        out[key] = value
+    return out
+
+
+def fj_decode(raw):
+    return fj_jsonlib.loads(raw, object_pairs_hook=fj_pairs)
+
+
+def fj_path(path):
+    path = FjPath(path)
+    fj_need(path.is_absolute() and '..' not in path.parts, 'finalization_path_not_absolute')
+    for item in (path, *path.parents):
+        fj_need(not item.is_symlink(), 'finalization_symlink')
+    return path
+
+
+def fj_read(path, limit=1024*1024):
+    path = fj_path(path)
+    fd = fj_os.open(path, fj_os.O_RDONLY | fj_os.O_NOFOLLOW | fj_os.O_CLOEXEC)
+    try:
+        before = fj_os.fstat(fd)
+        fj_need(fj_stat.S_ISREG(before.st_mode) and before.st_nlink == 1
+                and before.st_uid == fj_os.geteuid() and before.st_size <= limit,
+                'finalization_input_not_owned_regular_single_link')
+        chunks = []; size = 0
+        while True:
+            data = fj_os.read(fd, min(65536, limit+1-size))
+            if not data:
+                break
+            chunks.append(data); size += len(data)
+            fj_need(size <= limit, 'finalization_input_oversize')
+        after = fj_os.fstat(fd)
+        identity = lambda s: (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns)
+        fj_need(identity(before) == identity(after) and size == before.st_size,
+                'finalization_input_changed_during_read')
+        return b''.join(chunks)
+    finally:
+        fj_os.close(fd)
+
+
+def fj_db_identity(path):
+    st = fj_path(path).stat()
+    fj_need(fj_stat.S_ISREG(st.st_mode) and st.st_nlink == 1 and st.st_uid == fj_os.geteuid()
+            and fj_stat.S_IMODE(st.st_mode) in (0o600, 0o644), 'finalization_database_identity_unsafe')
+    return {'device': st.st_dev, 'inode': st.st_ino, 'uid': st.st_uid}
+
+
+# Explicit statements, never executescript inside a write transaction (which
+# would implicitly COMMIT). The exact schema is rechecked before any finalization.
+FJ_SCHEMA = (
+    '''CREATE TABLE sf_finalization_job (
+        singleton INTEGER PRIMARY KEY CHECK (singleton = 1),
+        binding TEXT NOT NULL, binding_sha256 TEXT NOT NULL,
+        task_id TEXT, last_run_id INTEGER, generation INTEGER NOT NULL DEFAULT 0,
+        state TEXT NOT NULL CHECK (state IN ('open','closed')),
+        receipt TEXT
+    )''',
+    '''CREATE TABLE sf_finalization_runs (
+        run_id INTEGER PRIMARY KEY, task_id TEXT NOT NULL,
+        profile TEXT, claim_lock TEXT, started_at INTEGER
+    )''',
+    '''CREATE TRIGGER sf_finalization_task_insert BEFORE INSERT ON tasks BEGIN
+        SELECT CASE WHEN sf_one_start_scope() != 'live'
+          OR (SELECT COUNT(*) FROM sf_finalization_job) != 1
+          OR (SELECT state FROM sf_finalization_job) != 'open'
+          OR (SELECT task_id FROM sf_finalization_job) IS NOT NULL
+          THEN RAISE(ABORT, 'one_start_task_insert_refused') END;
+    END''',
+    '''CREATE TRIGGER sf_finalization_task_bind AFTER INSERT ON tasks BEGIN
+        UPDATE sf_finalization_job SET task_id = NEW.id, generation = generation + 1;
+    END''',
+    '''CREATE TRIGGER sf_finalization_task_update BEFORE UPDATE ON tasks BEGIN
+        SELECT CASE WHEN sf_one_start_scope() NOT IN ('live','finalize')
+          OR (SELECT state FROM sf_finalization_job) != 'open'
+          OR OLD.id IS NOT (SELECT task_id FROM sf_finalization_job)
+          OR NEW.id IS NOT OLD.id
+          OR (NEW.current_run_id IS NOT NULL AND NEW.current_run_id IS NOT
+              (SELECT last_run_id FROM sf_finalization_job))
+          THEN RAISE(ABORT, 'one_start_task_update_refused') END;
+    END''',
+    '''CREATE TRIGGER sf_finalization_task_delete BEFORE DELETE ON tasks BEGIN
+        SELECT RAISE(ABORT, 'one_start_task_delete_refused');
+    END''',
+    '''CREATE TRIGGER sf_finalization_run_insert BEFORE INSERT ON task_runs BEGIN
+        SELECT CASE WHEN sf_one_start_scope() != 'live'
+          OR (SELECT state FROM sf_finalization_job) != 'open'
+          OR NEW.task_id IS NOT (SELECT task_id FROM sf_finalization_job)
+          OR EXISTS (SELECT 1 FROM task_runs WHERE ended_at IS NULL)
+          THEN RAISE(ABORT, 'one_start_run_insert_refused') END;
+    END''',
+    '''CREATE TRIGGER sf_finalization_run_bind AFTER INSERT ON task_runs BEGIN
+        INSERT INTO sf_finalization_runs(run_id, task_id, profile, claim_lock, started_at)
+            VALUES (NEW.id, NEW.task_id, NEW.profile, NEW.claim_lock, NEW.started_at);
+        UPDATE sf_finalization_job SET last_run_id = NEW.id, generation = generation + 1;
+    END''',
+    '''CREATE TRIGGER sf_finalization_run_update BEFORE UPDATE ON task_runs BEGIN
+        SELECT CASE WHEN sf_one_start_scope() NOT IN ('live','finalize')
+          OR (SELECT state FROM sf_finalization_job) != 'open'
+          OR NEW.id IS NOT OLD.id OR NEW.task_id IS NOT OLD.task_id
+          OR NEW.profile IS NOT OLD.profile OR NEW.started_at IS NOT OLD.started_at
+          OR (OLD.ended_at IS NOT NULL AND NEW.ended_at IS NOT OLD.ended_at)
+          THEN RAISE(ABORT, 'one_start_run_update_refused') END;
+    END''',
+    '''CREATE TRIGGER sf_finalization_run_delete BEFORE DELETE ON task_runs BEGIN
+        SELECT RAISE(ABORT, 'one_start_run_delete_refused');
+    END''',
+)
+
+
+def fj_schema_map():
+    return {statement.split()[2]: ' '.join(statement.split()) for statement in FJ_SCHEMA}
+
+
+def fj_check_schema(conn):
+    rows = conn.execute("SELECT name,sql FROM sqlite_master WHERE name GLOB 'sf_finalization_*'").fetchall()
+    actual = {row['name']: ' '.join(row['sql'].split()) for row in rows}
+    fj_need(actual == fj_schema_map(), 'finalization_schema_changed')
+
+
+def fj_register(conn, callback):
+    # Deliberately NOT deterministic: cancellation is checked on every statement.
+    conn.create_function('sf_one_start_scope', 0, callback, deterministic=False)
+
+
+def fj_binding_base(spec, descriptor_raw):
+    d = fj_decode(descriptor_raw)
+    job = fj_path(spec['job']); public = fj_path(d['public'])
+    expected_db = job/'task-home/.hermes/kanban/boards'/spec['board']/'kanban.db'
+    fj_need(fj_re.fullmatch(r'sf-job-[0-9a-f]{16}', spec['board']) is not None,
+            'finalization_board_not_private_job')
+    fj_need(fj_re.fullmatch(r'[a-z0-9][a-z0-9-]{0,39}', spec['job_id']) is not None,
+            'finalization_invalid_job_id')
+    fj_need(spec['db'] == str(expected_db) and d['job'] == str(job)
+            and d['job_id'] == spec['job_id'] and d['uid'] == fj_os.geteuid()
+            and d['candidate_manifest'] == spec['manifest']
+            and d['backend'] == 'systemd-user-v1'
+            and spec['public'] == str(public/'source-job')
+            and fj_re.fullmatch(r'[0-9a-f]{32}', d['token']) is not None,
+            'finalization_request_descriptor_mismatch')
+    fj_need(fj_sha(fj_read(job/'task_request.json', 32*1024*1024)) == d['request_sha256']
+            and fj_sha(fj_read(job/'source_job_driver.py', 32*1024*1024)) == d['driver_sha256'],
+            'finalization_driver_or_request_changed')
+    return {'schema': 1, 'protocol': FJ_PROTOCOL, 'job_id': spec['job_id'], 'token': d['token'],
+            'descriptor_sha256': fj_sha(descriptor_raw), 'request_sha256': d['request_sha256'],
+            'driver_sha256': d['driver_sha256'], 'candidate_manifest': spec['manifest'],
+            'board': spec['board'], 'db': str(expected_db), 'job': str(job), 'public': str(public),
+            'uid': d['uid'], 'boot': d['boot'], 'max_runs': 2*spec['loop_limits']['coding_cycles']}
+
+
+def fj_initialize(kb, spec, descriptor_raw):
+    """One admission-only initialization, before any service can start."""
+    binding = fj_binding_base(spec, descriptor_raw)
+    path = fj_path(binding['db'])
+    fj_need(not path.exists(), 'finalization_database_already_exists_no_readmission')
+    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    old_umask = fj_os.umask(0o077)
+    try:
+        with kb.connect_closing(path, board=binding['board']) as conn:
+            fj_need(conn.execute('SELECT COUNT(*) FROM tasks').fetchone()[0] == 0
+                    and conn.execute('SELECT COUNT(*) FROM task_runs').fetchone()[0] == 0,
+                    'finalization_requires_empty_new_database')
+            binding['database_identity'] = fj_db_identity(path)
+            with kb.write_txn(conn):
+                for statement in FJ_SCHEMA:
+                    conn.execute(statement)
+                conn.execute('INSERT INTO sf_finalization_job(singleton,binding,binding_sha256,state) VALUES(1,?,?,?)',
+                             (fj_bytes(binding).decode(), fj_sha(fj_bytes(binding)), 'open'))
+            fj_check_schema(conn)
+        return binding
+    finally:
+        fj_os.umask(old_umask)
+
+
+def fj_validate_binding(spec):
+    job = FjPath(spec['job'])
+    descriptor_raw = fj_read(job/'managed_job.json')
+    base = fj_binding_base(spec, descriptor_raw)
+    raw = fj_read(job/'finalization_binding.json')
+    fj_need(raw == fj_read(FjPath(base['public'])/'finalization_binding.json'),
+            'finalization_binding_copies_differ')
+    binding = fj_decode(raw)
+    fj_need(set(binding) == set(base)|{'database_identity'}
+            and all(binding[k] == v for k,v in base.items()), 'finalization_binding_identity_changed')
+    fj_need(binding['database_identity'] == fj_db_identity(binding['db']), 'finalization_database_replaced')
+    return binding
+
+
+def fj_live_scope(binding):
+    """Called by SQLite inside the service, never an authority from a report."""
+    try:
+        job, public = FjPath(binding['job']), FjPath(binding['public'])
+        if (public/'finalization_intent.json').exists() or (public/'stop_requested.json').exists():
+            return 'denied'
+        fj_need(binding['uid'] == fj_os.geteuid()
+                and FjPath('/proc/sys/kernel/random/boot_id').read_text().strip() == binding['boot'],
+                'finalization_live_boot_or_uid')
+        fj_need(fj_sha(fj_read(job/'managed_job.json')) == binding['descriptor_sha256'],
+                'finalization_live_descriptor_changed')
+        release = fj_decode(fj_read(public/'managed_service_release.json'))
+        record = fj_decode(fj_read(public/'service_native.json'))
+        unit = 'sf-job-'+binding['token']+'-native.service'
+        cg = release.get('cgroup')
+        fj_need(release.get('token') == binding['token'] and release.get('job_id') == binding['job_id']
+                and release.get('descriptor_sha256') == binding['descriptor_sha256']
+                and release.get('unit') == unit and record.get('unit') == unit
+                and record.get('token') == binding['token']
+                and record.get('descriptor_sha256') == binding['descriptor_sha256']
+                and record.get('uid') == binding['uid'] and record.get('boot') == binding['boot']
+                and record.get('invocation_id') == release.get('invocation_id')
+                and type(release.get('invocation_id')) is str
+                and fj_re.fullmatch(r'[0-9a-f]{32}', release['invocation_id']) is not None
+                and type(cg) is str and cg.endswith('/'+unit) and record.get('cgroup') == cg,
+                'finalization_live_service_binding')
+        groups = FjPath('/proc/self/cgroup').read_text().splitlines()
+        fj_need(groups == ['0::'+cg], 'finalization_writer_outside_bound_cgroup')
+        fj_need(fj_db_identity(binding['db']) == binding['database_identity'],
+                'finalization_live_database_replaced')
+        return 'live'
+    except Exception:
+        return 'denied'
+
+
+def fj_install_runtime(spec):
+    """Add one connection function; retain the native connector and transactions."""
+    binding = fj_validate_binding(spec)
+    from hermes_cli import kanban_db as kb
+    fj_need(not hasattr(kb, '_sf_finalization_binding'), 'finalization_hook_already_installed')
+    native_connect = kb._sqlite_connect
+    def connect(*args, **kwargs):
+        conn = native_connect(*args, **kwargs)
+        try:
+            names = conn.execute('PRAGMA database_list').fetchall()
+            main = next(row[2] for row in names if row[1] == 'main')
+            if main == binding['db']:
+                fj_register(conn, lambda: fj_live_scope(binding))
+            return conn
+        except BaseException:
+            conn.close()
+            raise
+    kb._sf_finalization_binding = dict(binding)
+    kb._sqlite_connect = connect
+    return binding
+
+
+@fj_contextlib.contextmanager
+def fj_open(binding):
+    """Open an EXISTING bound DB, never kb.connect's repair/init/quarantine path."""
+    path = fj_path(binding['db'])
+    fj_need(fj_db_identity(path) == binding['database_identity'], 'finalization_database_replaced')
+    # Check sidecars as well; no symlink/hardlink escape through SQLite journaling.
+    for suffix in ('-wal','-shm','-journal'):
+        sidecar = fj_path(str(path)+suffix)
+        if sidecar.exists():
+            st = sidecar.stat()
+            fj_need(fj_stat.S_ISREG(st.st_mode) and st.st_uid == binding['uid'] and st.st_nlink == 1,
+                    'finalization_unsafe_database_sidecar')
+    conn = fj_sqlite3.connect(path.as_uri()+'?mode=rw', uri=True, timeout=0.1)
+    conn.row_factory = fj_sqlite3.Row
+    try:
+        conn.execute('PRAGMA foreign_keys=ON')
+        conn.execute('PRAGMA synchronous=FULL')
+        conn.execute('PRAGMA busy_timeout=100')
+        fj_register(conn, lambda: 'finalize')
+        fj_need(fj_db_identity(path) == binding['database_identity'], 'finalization_database_replaced_on_open')
+        fj_check_schema(conn)
+        yield conn
+    finally:
+        if conn.in_transaction:
+            conn.rollback()
+        conn.close()
+
+
+def fj_guard(conn, binding):
+    rows = conn.execute('SELECT * FROM sf_finalization_job').fetchall()
+    fj_need(len(rows) == 1 and rows[0]['singleton'] == 1, 'finalization_guard_cardinality')
+    row = dict(rows[0])
+    fj_need(row['binding'] == fj_bytes(binding).decode()
+            and row['binding_sha256'] == fj_sha(fj_bytes(binding)), 'finalization_guard_binding_changed')
+    return row
+
+
+def fj_snapshot(conn, binding):
+    fj_check_schema(conn)
+    guard = fj_guard(conn, binding)
+    tid = guard['task_id']
+    tasks = conn.execute('SELECT * FROM tasks').fetchall()
+    # This is a one-card database from admission. Never pick a card by status.
+    fj_need(len(tasks) == (0 if tid is None else 1), 'finalization_task_inventory_changed')
+    task = dict(tasks[0]) if tasks else None
+    fj_need(task is None or task['id'] == tid, 'finalization_task_binding_changed')
+    runs = [dict(r) for r in conn.execute('SELECT * FROM task_runs ORDER BY id')]
+    journal = [dict(r) for r in conn.execute('SELECT * FROM sf_finalization_runs ORDER BY run_id')]
+    fj_need(len(runs) == len(journal) <= binding['max_runs'], 'finalization_run_inventory_changed')
+    fj_need(guard['last_run_id'] == (runs[-1]['id'] if runs else None)
+            and guard['generation'] == len(runs)+(1 if task else 0), 'finalization_run_generation_changed')
+    for run, saved in zip(runs, journal):
+        fj_need(run['id'] == saved['run_id'] and run['task_id'] == saved['task_id'] == tid
+                and run['profile'] == saved['profile'] and run['started_at'] == saved['started_at'],
+                'finalization_run_binding_changed')
+        if run['ended_at'] is None:
+            fj_need(run['claim_lock'] == saved['claim_lock'], 'finalization_run_claim_changed')
+    open_runs = [r for r in runs if r['ended_at'] is None]
+    if open_runs:
+        fj_need(len(open_runs) == 1 and task is not None and task['status'] == 'running'
+                and task['current_run_id'] == open_runs[0]['id'] == guard['last_run_id']
+                and task['claim_lock'] == open_runs[0]['claim_lock']
+                and task['assignee'] == open_runs[0]['profile'], 'finalization_active_run_conflict')
+        fj_need(task['worker_pid'] == open_runs[0]['worker_pid'], 'finalization_worker_binding_changed')
+    elif task is not None:
+        fj_need(task['current_run_id'] is None and task['claim_lock'] is None
+                and task['claim_expires'] is None and task['worker_pid'] is None
+                and task['status'] != 'running', 'finalization_unjournaled_active_claim')
+    snapshot = {'generation': guard['generation'], 'task': task, 'runs': runs, 'journal': journal}
+    return snapshot, fj_sha(fj_bytes(snapshot))
+
+
+def fj_validate_intent(binding, intent):
+    expected = fj_sha(fj_bytes({'protocol': FJ_PROTOCOL, 'binding_sha256': fj_sha(fj_bytes(binding))}))
+    fj_need(set(intent) == {'schema','protocol','binding_sha256','operation_id','reason','created_utc'}
+            and intent['schema'] == 1 and intent['protocol'] == FJ_PROTOCOL
+            and intent['binding_sha256'] == fj_sha(fj_bytes(binding))
+            and intent['operation_id'] == expected
+            and intent['reason'] in ('failed','cancelled','monitor_lost','postflight_failed'),
+            'finalization_intent_identity_changed')
+    return expected
+
+
+def fj_validate_quiescence(binding, proof):
+    fj_need(proof.get('schema') == 1 and proof.get('binding_sha256') == fj_sha(fj_bytes(binding))
+            and proof.get('token') == binding['token'] and proof.get('boot') == binding['boot']
+            and proof.get('descriptor_sha256') == binding['descriptor_sha256']
+            and proof.get('admission_fenced') is True and proof.get('start_consumed') is True,
+            'finalization_quiescence_binding_changed')
+    if proof.get('kind') == 'never_launched':
+        fj_need(proof.get('unit_not_found') is True and proof.get('service_record_absent') is True
+                and proof.get('release_artifacts_absent') is True, 'finalization_never_launched_not_proved')
+    else:
+        fj_need(proof.get('kind') == 'bound_service_empty'
+                and type(proof.get('invocation_id')) is str
+                and fj_re.fullmatch(r'[0-9a-f]{32}', proof['invocation_id']) is not None
+                and proof.get('unit') == 'sf-job-'+binding['token']+'-native.service'
+                and type(proof.get('cgroup')) is str and proof['cgroup'].endswith('/'+proof['unit'])
+                and proof.get('cgroup_empty') is True and proof.get('observed_processes_absent') is True
+                and proof.get('diagnostic_absence_only') is False
+                and proof.get('previous_boot_ended') is False
+                and proof.get('manager_terminal') is True,
+                'finalization_service_not_verified_quiescent')
+
+
+def fj_finalize(kb, conn, binding, intent, proof, expected_snapshot_sha):
+    """One atomic closure; DB receipt survives a crash before external reporting."""
+    operation = fj_validate_intent(binding, intent)
+    fj_validate_quiescence(binding, proof)
+    fj_need(fj_db_identity(binding['db']) == binding['database_identity'], 'finalization_database_replaced')
+    with kb.write_txn(conn):
+        fj_check_schema(conn)
+        guard = fj_guard(conn, binding)
+        if guard['state'] == 'closed':
+            receipt = fj_decode(guard['receipt'])
+            fj_need(receipt['operation_id'] == operation and receipt['intent'] == intent
+                    and receipt['binding_sha256'] == fj_sha(fj_bytes(binding))
+                    and receipt['quiescence_sha256'] == fj_sha(fj_bytes(receipt['quiescence'])),
+                    'finalization_closed_operation_conflict')
+            fj_validate_quiescence(binding, receipt['quiescence'])
+            snap, unused = fj_snapshot(conn, binding)
+            fj_need(fj_sha(fj_bytes(snap)) == receipt['final_snapshot_sha256'],
+                    'finalization_closed_snapshot_changed')
+            return receipt
+        snap, actual_sha = fj_snapshot(conn, binding)
+        fj_need(actual_sha == expected_snapshot_sha, 'finalization_compare_and_swap_conflict')
+        task = snap['task']; tid = task['id'] if task else None
+        fj_need(proof['kind'] != 'never_launched' or (task is None and not snap['runs']),
+                'finalization_task_exists_without_service')
+        done = task is not None and task['status'] == 'done'
+        fj_need(task is None or task['status'] in ('ready','running','review','blocked','done'),
+                'finalization_unexpected_native_state')
+        closed_run = None
+        if task is not None and not done:
+            if task['current_run_id'] is not None:
+                own = next(r for r in snap['runs'] if r['id'] == task['current_run_id'])
+                metadata = fj_decode(own['metadata']) if own['metadata'] else {}
+                fj_need(type(metadata) is dict and 'one_start_finalization' not in metadata,
+                        'finalization_run_metadata_conflict')
+                metadata = dict(metadata, one_start_finalization={
+                    'operation_id': operation, 'reason': intent['reason'], 'no_retry': True})
+                closed_run = kb._end_run(conn, tid, outcome='blocked', status='blocked',
+                    error='one_start_'+intent['reason'], summary='One-start job ended; no automatic retry.',
+                    metadata=metadata)
+                fj_need(closed_run == task['current_run_id'], 'finalization_wrong_run_closed')
+            changed = conn.execute('''UPDATE tasks SET status='blocked', block_kind='needs_input',
+                current_run_id=NULL, worker_pid=NULL, claim_lock=NULL, claim_expires=NULL,
+                last_failure_error=? WHERE id=?''', ('one_start_'+intent['reason'], tid))
+            fj_need(changed.rowcount == 1, 'finalization_task_update_lost')
+        receipt = {'schema': 1, 'protocol': FJ_PROTOCOL, 'operation_id': operation,
+            'binding_sha256': fj_sha(fj_bytes(binding)), 'intent': intent,
+            'job_id': binding['job_id'], 'board': binding['board'], 'task_id': tid,
+            'last_run_id': guard['last_run_id'], 'closed_run_id': closed_run,
+            'prior_native_status': task['status'] if task else None,
+            'native_status': 'done' if done else ('blocked' if task else None),
+            'preserved_done': done, 'no_task_created': task is None,
+            'job_outcome': 'cancelled' if intent['reason'] == 'cancelled' else 'failed',
+            'start_consumed': True, 'task_requeued': False, 'inference_retried': False,
+            'quiescence_sha256': fj_sha(fj_bytes(proof)), 'quiescence': proof}
+        if task is not None:
+            # 'blocked' is also the native sticky-block fact, not circuit-breaker
+            # gave_up (which native recompute_ready may automatically promote).
+            kb._append_event(conn, tid, 'one_start_finalized' if done else 'blocked',
+                {'kind': 'needs_input', 'reason': 'one_start_'+intent['reason'],
+                 'operation_id': operation, 'no_retry': True, 'preserved_done': done},
+                run_id=guard['last_run_id'])
+        final, unused = fj_snapshot(conn, binding)
+        receipt['final_snapshot_sha256'] = fj_sha(fj_bytes(final))
+        conn.execute("UPDATE sf_finalization_job SET state='closed',receipt=? WHERE singleton=1 AND state='open'",
+                     (fj_bytes(receipt).decode(),))
+    return receipt
+
+
+def fj_admit_prepared_board(kb, spec):
+    """Replace only the FUTURE controller's old 'board must not exist' check.
+
+    Admission now creates the empty bound DB before launch, so the historical
+    predicate cannot be reused. The legacy and accepted managed drivers keep it.
+    """
+    binding=fj_validate_binding(spec)
+    fj_need(fj_live_scope(binding)=='live','finalization_board_outside_bound_service')
+    fj_need(str(kb.kanban_db_path(board=spec['board']))==binding['db'], 'finalization_board_path_changed')
+    with kb.connect_closing(board=spec['board']) as conn:
+        guard=fj_guard(conn,binding)
+        snapshot,unused=fj_snapshot(conn,binding)
+        fj_need(guard['state']=='open' and snapshot['task'] is None and not snapshot['runs'],
+                'finalization_board_already_consumed')
+    fj_need(not (FjPath(binding['db']).parent/'board.json').exists(), 'finalization_board_metadata_already_exists')
+    kb.create_board(spec['board'])
+    kb.set_current_board(spec['board'])
diff --git a/factory_model_boundary.py b/factory_model_boundary.py
new file mode 100644
index 0000000000000000000000000000000000000000..ea0b8f773b0c8e26b1a5617f964ac7c500973ca8
--- /dev/null
+++ b/factory_model_boundary.py
@@ -0,0 +1,233 @@
+"""Semantyczna powierzchnia modelu: ścisły, ograniczony podzbiór czterech formatów.
+
+Nie ufa temu, że builder sam wpisał hash do zbioru. Dekoduje narzędzia z żądania
+wobec definicji zapamiętanych przy starcie. Nie aprobuje arbitralnych rozszerzeń
+providera ani usuwania ograniczeń schematów. Brak wsparcia oznacza odmowę,
+nie automatyczne poluzowanie lub próbę wysłania. To nie walidator całego SDK.
+"""
+from __future__ import annotations
+
+import json
+from typing import Any
+
+
+class ModelBoundaryError(ValueError):
+    """Nieznany format lub powierzchnia wykonawcza oznacza odmowę przed klientem."""
+
+
+# Pola danych/parametrów generacji, nie kanały rozszerzeń wykonawczych. Nieznane
+# top-level keys również odmawiają; extra_body nie może nadpisać pola po kontroli.
+_COMMON = {'stream', 'timeout', 'extra_body'}
+_FIELDS = {
+    'chat_completions': _COMMON | {
+        'model', 'messages', 'tools', 'tool_choice', 'parallel_tool_calls',
+        'max_tokens', 'max_completion_tokens', 'temperature', 'top_p', 'seed',
+        'stop', 'frequency_penalty', 'presence_penalty', 'logprobs', 'top_logprobs',
+        'logit_bias', 'n', 'user', 'store', 'metadata', 'service_tier',
+        'stream_options', 'response_format', 'reasoning_effort',
+        'prompt_cache_key', 'prompt_cache_retention', 'safety_identifier',
+    },
+    'codex_responses': _COMMON | {
+        'model', 'input', 'instructions', 'tools', 'tool_choice',
+        'parallel_tool_calls', 'max_output_tokens', 'temperature', 'top_p',
+        'store', 'metadata', 'service_tier', 'reasoning', 'text', 'include',
+        'truncation', 'prompt_cache_key', 'prompt_cache_retention', 'user',
+        'safety_identifier', 'extra_headers',
+    },
+    'anthropic_messages': _COMMON | {
+        'model', 'messages', 'system', 'tools', 'tool_choice', 'max_tokens',
+        'temperature', 'top_p', 'top_k', 'stop_sequences', 'metadata',
+        'thinking', 'output_config', 'service_tier',
+    },
+    'bedrock_converse': _COMMON | {
+        'modelId', 'messages', 'system', 'toolConfig', 'inferenceConfig',
+        'guardrailConfig', 'requestMetadata', 'performanceConfig',
+        '__bedrock_converse__', '__bedrock_region__',
+    },
+}
+
+
+def is_moa_provider(provider: Any) -> bool:
+    """MoA is a separate fan-out runtime, not an approved provider wrapper.
+
+    Match the native initializer's normalization; never whitelist its private
+    prepared-request payload as if it were a passive SDK data field.
+    """
+    return isinstance(provider, str) and provider.strip().lower() == "moa"
+
+
+def _json(value: Any) -> str:
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False)
+
+
+def _refuse(reason: str) -> None:
+    raise ModelBoundaryError(reason)
+
+
+def _cache(value: Any) -> None:
+    if (type(value) is not dict or set(value) - {'type', 'ttl'}
+            or value.get('type') != 'ephemeral'
+            or value.get('ttl', '5m') not in {'5m', '1h'}):
+        _refuse('unrecognized tool cache annotation')
+
+
+def _tool(agent: Any, mode: str, value: Any) -> dict:
+    if type(value) is not dict:
+        _refuse('tool is not an object')
+    value = dict(value)
+    if 'cache_control' in value:
+        _cache(value.pop('cache_control'))
+    if mode == 'chat_completions':
+        if set(value) != {'type', 'function'} or value['type'] != 'function':
+            _refuse('non-function or extended chat tool')
+        fn = value['function']
+        if type(fn) is not dict or set(fn) != {'name', 'description', 'parameters'}:
+            _refuse('unrecognized chat function shape')
+        return fn
+    if mode == 'codex_responses':
+        if (set(value) != {'type', 'name', 'description', 'parameters', 'strict'}
+                or value['type'] != 'function' or value['strict'] is not False):
+            _refuse('non-function or extended responses tool')
+        return {k: value[k] for k in ('name', 'description', 'parameters')}
+    if mode == 'anthropic_messages':
+        if set(value) != {'name', 'description', 'input_schema'}:
+            _refuse('non-function or extended messages tool')
+        name = value['name']
+        if getattr(agent, '_is_anthropic_oauth', False):
+            if type(name) is not str or not name.startswith('mcp__'):
+                _refuse('missing approved OAuth name prefix')
+            name = name[len('mcp__'):]
+        return {'name': name, 'description': value['description'], 'parameters': value['input_schema']}
+    if (set(value) != {'toolSpec'} or type(value['toolSpec']) is not dict
+            or set(value['toolSpec']) != {'name', 'description', 'inputSchema'}):
+        _refuse('non-function or extended converse tool')
+    spec = value['toolSpec']
+    if type(spec['inputSchema']) is not dict or set(spec['inputSchema']) != {'json'}:
+        _refuse('unrecognized converse input schema')
+    return {'name': spec['name'], 'description': spec['description'], 'parameters': spec['inputSchema']['json']}
+
+
+def _choice(value: Any, names: set[str], mode: str, agent: Any) -> None:
+    if value is None or (type(value) is str and value in {'auto', 'required', 'none'}):
+        return
+    if type(value) is not dict:
+        _refuse('unrecognized tool choice')
+    name = None
+    if mode == 'chat_completions' and set(value) == {'type', 'function'} and value['type'] == 'function':
+        if type(value['function']) is dict and set(value['function']) == {'name'}:
+            name = value['function']['name']
+    elif mode == 'codex_responses' and set(value) == {'type', 'name'} and value['type'] == 'function':
+        name = value['name']
+    elif mode == 'anthropic_messages':
+        selection = {k: v for k, v in value.items() if k != 'disable_parallel_tool_use'}
+        if 'disable_parallel_tool_use' in value and type(value['disable_parallel_tool_use']) is not bool:
+            _refuse('invalid parallel choice')
+        if selection in ({'type': 'auto'}, {'type': 'any'}, {'type': 'none'}):
+            return
+        if set(selection) == {'type', 'name'} and selection['type'] == 'tool':
+            name = selection['name']
+            if getattr(agent, '_is_anthropic_oauth', False) and type(name) is str and name.startswith('mcp__'):
+                name = name[len('mcp__'):]
+    elif mode == 'bedrock_converse':
+        if value in ({'auto': {}}, {'any': {}}):
+            return
+        if set(value) == {'tool'} and type(value['tool']) is dict and set(value['tool']) == {'name'}:
+            name = value['tool']['name']
+    if type(name) is not str or name not in names:
+        _refuse('choice is outside transmitted capability set')
+
+
+def _codex_headers(agent: Any, payload: dict) -> dict[str, str]:
+    """Only native Codex session/cache headers, never arbitrary SDK headers.
+
+    Both values must match their existing request/session identities. Include
+    these headers in the registered envelope so changing even both sides of a
+    cache-key/header pair after the builder is refused by the final-call gate.
+    No Authorization, Host, beta headers, aliases, routing override or extra_body.
+    Other providers and custom Codex endpoints remain unsupported here.
+    """
+    if 'extra_headers' not in payload:
+        return {}
+    if (getattr(agent, 'provider', None) != 'openai-codex'
+            or getattr(agent, 'base_url', None) not in {
+                'https://chatgpt.com/backend-api/codex',
+                'https://chatgpt.com/backend-api/codex/'}):
+        _refuse('Codex headers require the approved provider and endpoint')
+    headers = payload['extra_headers']
+    if (type(headers) is not dict
+            or any(type(k) is not str for k in headers)
+            or set(headers) != {'session_id', 'x-client-request-id'}):
+        _refuse('unapproved Codex header set')
+    session = getattr(agent, 'session_id', None)
+    cache_key = payload.get('prompt_cache_key')
+    for value, limit in ((session, 256), (cache_key, 64)):
+        if (type(value) is not str or not 0 < len(value) <= limit
+                or any(not 33 <= ord(c) <= 126 for c in value)):
+            _refuse('invalid Codex session or cache identity')
+    expected = {'session_id': session, 'x-client-request-id': cache_key}
+    if (any(type(v) is not str for v in headers.values()) or headers != expected):
+        _refuse('Codex header identity mismatch')
+    return dict(headers)
+
+
+def capabilities(agent: Any, payload: Any, definitions: dict[str, str],
+                 allowed_names: set[str] | None = None) -> dict:
+    """Zwróć kanoniczny opis uprawnień, bez treści rozmowy i tokenów klienta."""
+    if type(payload) is not dict or any(type(k) is not str for k in payload):
+        _refuse('model payload is not a plain dictionary')
+    mode = getattr(agent, 'api_mode', '')
+    if mode not in _FIELDS or set(payload) - _FIELDS[mode]:
+        _refuse('unreviewed request mode or top-level extension')
+    # Rozszerzenia są kanałem nadpisywania SDK. Do zatwierdzenia ich semantyki
+    # dopuszczamy tylko brak/pusty obiekt. Dotyczy też potencjalnie łagodnych opcji.
+    if payload.get('extra_body') not in (None, {}):
+        _refuse('unreviewed extra_body extension')
+    if 'extra_body' in payload and payload['extra_body'] is not None and type(payload['extra_body']) is not dict:
+        _refuse('invalid extra_body type')
+    model = payload.get('modelId' if mode == 'bedrock_converse' else 'model')
+    if type(model) is not str or model != getattr(agent, 'model', None):
+        _refuse('request model differs from active route')
+    headers = _codex_headers(agent, payload) if mode == 'codex_responses' else {}
+    choice = payload.get('tool_choice')
+    tools = payload.get('tools', [])
+    if tools is None:
+        tools = []
+    if mode == 'bedrock_converse':
+        config = payload.get('toolConfig')
+        if config is not None:
+            if type(config) is not dict or set(config) - {'tools', 'toolChoice'}:
+                _refuse('extended converse tool configuration')
+            tools = config.get('tools', [])
+            if tools is None:
+                tools = []
+            choice = config.get('toolChoice')
+    if type(tools) is not list:
+        _refuse('invalid transported tool list')
+    names: set[str] = set()
+    canonical = {}
+    cache_points = 0
+    for value in tools:
+        if mode == 'bedrock_converse' and value == {'cachePoint': {'type': 'default'}}:
+            cache_points += 1
+            if cache_points > 1:
+                _refuse('duplicate converse tool cache annotation')
+            continue
+        fn = _tool(agent, mode, value)
+        name = fn.get('name')
+        if type(name) is not str or name in names or name not in definitions:
+            _refuse('duplicate or unapproved transported tool')
+        expected = json.loads(definitions[name])['function']
+        if _json(fn) != _json(expected):
+            _refuse('transport changed an approved function schema')
+        if allowed_names is not None and name not in allowed_names:
+            _refuse('transport widened the requested tool subset')
+        canonical[name] = fn
+        names.add(name)
+    _choice(choice, names, mode, agent)
+    if 'parallel_tool_calls' in payload and type(payload['parallel_tool_calls']) is not bool:
+        _refuse('invalid parallel_tool_calls')
+    return {'tools': canonical, 'choice': choice,
+            'parallel': payload.get('parallel_tool_calls'),
+            'extra_body': payload.get('extra_body'),
+            'transport_headers': headers,
+            '_route': [mode, getattr(agent, 'provider', ''), model]}
diff --git a/factory_one_start.py b/factory_one_start.py
new file mode 100644
index 0000000000000000000000000000000000000000..8f796881aac9d4e5cdfcbe1bc49a51a947ac8aad
--- /dev/null
+++ b/factory_one_start.py
@@ -0,0 +1,54 @@
+"""Funkcja one-start w chronionym workerze prywatnego zadania, przed pierwszym narzędziem.
+
+Wywoływane wyłącznie z bramek startu (factory_worker_start, factory_profile_start)
+po weryfikacji pinów źródeł, tożsamości profilu i konfiguracji. Na tablicy
+`sf-job-*` instalacja jest obowiązkowa, a każdy błąd zatrzymuje start; na innych
+tablicach moduł nic nie robi. Wiązanie, hook połączeń i ocena `live` pochodzą bez
+zmian z przypiętej kopii finalization_core (factory_finalization_core.py).
+Worker poza cgroup związanej usługi albo po żądaniu zatrzymania nie startuje.
+To nie jest sandbox przeciw kodowi tego samego UID.
+"""
+from __future__ import annotations
+
+import os
+import re
+
+_JOB_BOARD = re.compile(r"sf-job-[0-9a-f]{16}")
+_DB_LAYOUT = ("kanban.db", None, "boards", "kanban", ".hermes", "task-home")
+
+
+class OneStartError(RuntimeError):
+    pass
+
+
+def _need(ok: object, code: str) -> None:
+    if not ok:
+        raise OneStartError(code)
+
+
+def install_for_worker() -> dict | None:
+    """Zainstaluj hook one-start dla bazy bieżącego zadania albo zwróć None poza `sf-job-*`."""
+    board = os.environ.get("HERMES_KANBAN_BOARD", "").strip()
+    if not _JOB_BOARD.fullmatch(board):
+        return None
+    import factory_finalization_core as fj
+
+    # fj_path: ścieżka absolutna, bez '..' i bez dowiązań w żadnym składniku.
+    db = fj.fj_path(os.environ.get("HERMES_KANBAN_DB", ""))
+    names = (db.name, *(p.name for p in db.parents[:5]))
+    _need(len(db.parts) > 7 and names == ("kanban.db", board) + _DB_LAYOUT[2:], "one_start_db_layout")
+    job = db.parents[5]
+    spec = fj.fj_decode(fj.fj_read(job / "task_request.json", 32 * 1024 * 1024))
+    _need(type(spec) is dict and spec.get("board") == board and spec.get("db") == str(db)
+          and spec.get("job") == str(job), "one_start_spec_binding")
+    binding = fj.fj_install_runtime(spec)
+    _need(binding.get("db") == str(db) and binding.get("board") == board, "one_start_binding")
+    from hermes_cli import kanban_db as kb
+
+    conn = kb._sqlite_connect(db)
+    try:
+        scope = conn.execute("SELECT sf_one_start_scope()").fetchone()[0]
+    finally:
+        conn.close()
+    _need(scope == "live", "one_start_worker_outside_bound_service")
+    return dict(binding)
diff --git a/factory_profile_start.py b/factory_profile_start.py
new file mode 100644
index 0000000000000000000000000000000000000000..64a77fbd9c5cc85aa861678d9c051d732d920ce5
--- /dev/null
+++ b/factory_profile_start.py
@@ -0,0 +1,246 @@
+"""Natywna kontrola STARTU reviewer-gpt/release-manager poza oboma pluginami.
+
+Dowód obu pluginów jest wiązany z agentem po kontroli AFTER. Lifetime sprawdza
+jego zachowanie przed dopuszczeniem operacji i zatwierdzeniem approval.
+Nie zastępuje cache-safe launchera ani kontroli już importowanego kodu.
+"""
+from __future__ import annotations
+import hashlib
+import importlib
+import os
+import sys
+from contextvars import ContextVar
+from types import ModuleType
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+GUARD = 'factory-execution-guards'
+READONLY = 'factory-repository-readonly'
+PROFILES = frozenset({'reviewer-gpt', 'release-manager'})
+REPO_TOOLS = frozenset({'factory_repo_map','factory_repo_read','factory_repo_search'})
+MODEL_TOOLS = {'reviewer-gpt': REPO_TOOLS | {'kanban_show','kanban_request_changes','factory_review_approve'},
+               'release-manager': REPO_TOOLS}
+DISABLED = frozenset({'terminal','file','code_execution','web','browser','image_gen','delegation','computer_use','cronjob','skills','vision','todo','memory','session_search','clarify','messaging','tts','moa','bfl','x_search','mcp'})
+READONLY_PINS = {
+    "__init__.py": "45985ac4faa072055a4e03d0ae005bd479fca55a3046de23a399067e7545af71",
+    "kanban_guard.py": "f38cb4038757c822eb18ec03faf0b22d8a5ae9f7fb9346410f0433650000b93d",
+    "plugin.yaml": "b82696753bc88c1bad7eec5266a3b3d4f37152aa703b7fb850b1c08909b1c337",
+    "repo_map.py": "88b7d66c33ce8fb8b80e7e8e6bbf47462abda27246386bc9767ee4d62a74ef3c",
+    "repository_tools.py": "a93794aa9aeb8496ce46537a7907d9b66473ea2961efc49f3cac904502d61a80"
+}
+
+
+def selected_profile() -> str | None:
+    """Rozpoznaj chronione ścieżki stdlibem, przed natywnymi importami profilu."""
+    declared = os.environ.get('HERMES_PROFILE')
+    if declared in PROFILES | {'coder-claude'}:
+        return declared
+    candidates = [os.environ.get('HERMES_HOME', '')]
+    # An in-process gateway/task may scope its home with ContextVar rather than
+    # environment variables. Read only the existing stdlib ContextVar; do NOT
+    # import or call native getters before the selected profile's pin gate.
+    # Already imported interpreter/modules remain an explicit trust boundary.
+    constants = sys.modules.get('hermes_constants')
+    if type(constants) is ModuleType:
+        override = vars(constants).get('_HERMES_HOME_OVERRIDE')
+        if type(override) is ContextVar:
+            scoped = override.get(None)
+            if type(scoped) is str and scoped:
+                candidates.insert(0, scoped)
+    for raw in candidates:
+        if raw:
+            home = Path(raw).expanduser().resolve(strict=False)
+            for profile in PROFILES | {'coder-claude'}:
+                parent = 'factory-profiles' if profile=='release-manager' else 'profiles'
+                if home == (Path.home()/'.hermes'/parent/profile).resolve(strict=False):
+                    return profile
+    return None
+
+
+def _fail(message: str) -> None:
+    from factory_worker_start import WorkerStartError
+    raise WorkerStartError('FACTORY_PROFILE_START_REFUSED: ' + message)
+
+
+def _sources(profile: str) -> Path:
+    from factory_worker_start import _canonical, _check_sources
+    if profile not in PROFILES or os.environ.get('HERMES_PROFILE') != profile:
+        _fail('profile identity mismatch')
+    raw = os.environ.get('HERMES_HOME','')
+    if not raw:
+        _fail('profile home missing')
+    home = _canonical(Path(raw))
+    parent = 'factory-profiles' if profile=='release-manager' else 'profiles'
+    if home != Path.home()/'.hermes'/parent/profile:
+        _fail('profile home identity mismatch')
+    _check_sources(home)  # pełne natywne piny + osiem plików guarda, bez importów Hermesa
+    root = _canonical(home/'plugins'/READONLY)
+    actual = {}
+    for path in root.rglob('*'):
+        if path.is_symlink(): _fail('readonly source symlink')
+        if path.is_file():
+            _canonical(path)
+            actual[path.relative_to(root).as_posix()] = hashlib.sha256(path.read_bytes()).hexdigest()
+    if actual != READONLY_PINS:
+        _fail('readonly source file set/hash mismatch')
+    return home
+
+
+def _identity(profile: str, home: Path) -> None:
+    from hermes_constants import get_hermes_home
+    from hermes_cli.profiles import get_active_profile_name
+    inferred = 'custom' if profile=='release-manager' else profile
+    if os.environ.get('HERMES_PROFILE') != profile or get_hermes_home()!=home or get_active_profile_name()!=inferred:
+        _fail('native profile identity mismatch')
+
+
+def _configuration(profile: str, enabled: Any, disabled: Any) -> None:
+    from hermes_cli.config import load_config_readonly
+    base = {GUARD, READONLY}
+    allowed = [base | {'kanban'}] if profile=='reviewer-gpt' else [base,base | {'kanban'}]
+    if (type(enabled) is not list or any(type(x) is not str for x in enabled)
+            or len(enabled)!=len(set(enabled)) or set(enabled) not in allowed
+            or type(disabled) is not list or any(type(x) is not str for x in disabled)
+            or len(disabled)!=len(DISABLED) or set(disabled)!=DISABLED):
+        _fail('explicit toolsets/disabled boundary mismatch')
+    config = load_config_readonly()
+    plugins = config.get('plugins', {})
+    entries = {GUARD:{'allow_tool_override':True},READONLY:{'allow_tool_override':False}}
+    if (plugins.get('enabled') != [GUARD,READONLY] or plugins.get('disabled',[])!=[]
+            or plugins.get('entries')!=entries
+            or plugins['entries'][GUARD]['allow_tool_override'] is not True
+            or plugins['entries'][READONLY]['allow_tool_override'] is not False):
+        _fail('plugin configuration mismatch')
+    stored = config.get('agent',{}).get('disabled_toolsets')
+    if type(stored) is not list or any(type(x) is not str for x in stored) or len(stored)!=len(DISABLED) or set(stored)!=DISABLED:
+        _fail('stored disabled boundary mismatch')
+    if config.get('mcp_servers',{})!={} or config.get('tools',{}).get('tool_search',{}).get('enabled')!='off':
+        _fail('dynamic capability discovery must be disabled')
+    backend = 'native-openai' if profile=='reviewer-gpt' else 'read-only-release-decision'
+    if config.get('factory',{}).get('execution_backend') != backend:
+        _fail('profile backend configuration mismatch')
+
+
+@dataclass(frozen=True)
+class ProfileStartProof:
+    profile: str
+    home: Path
+    manager: Any
+    loaded: tuple
+    entries: dict
+    metadata: dict
+    enabled: tuple
+    disabled: tuple
+    pid: int
+    registry: Any
+    module: Any
+    readonly_module: Any
+    bindings: tuple
+
+    def verify(self) -> None:
+        from factory_worker_start import _module_source, _entry_metadata
+        from hermes_cli.plugins import get_plugin_manager
+        from tools.registry import registry
+        if (self.pid != os.getpid() or _sources(self.profile)!=self.home
+                or tuple((k, os.environ.get(k)) for k, _ in self.bindings) != self.bindings):
+            _fail('profile/source identity changed')
+        _identity(self.profile,self.home)
+        _configuration(self.profile,list(self.enabled),list(self.disabled))
+        if (get_plugin_manager() is not self.manager or registry is not self.registry
+                or registry.current_scope_key()!=str(self.home) or self.manager.scope_key!=str(self.home)):
+            _fail('manager/registry scope changed')
+        for name, loaded in zip((GUARD,READONLY),self.loaded):
+            if self.manager._plugins.get(name) is not loaded or not loaded.enabled or loaded.error or loaded.module is None:
+                _fail('required plugin unloaded/replaced')
+            _module_source(loaded.module,self.home/'plugins'/name/'__init__.py')
+        guard,readonly = (x.module for x in self.loaded)
+        if guard is not self.module or readonly is not self.readonly_module:
+            _fail('required module generation changed')
+        expected = {'pre_tool_call':[guard.on_pre_tool_call,readonly.on_pre_tool_call],
+                    'post_tool_call':[guard.on_post_tool_call]}
+        for name,callbacks in expected.items():
+            actual=self.manager._hooks.get(name,[])
+            if len(actual)!=len(callbacks) or set(actual)!=set(callbacks):
+                _fail('required hook identity/count mismatch')
+        for name,entry in self.entries.items():
+            if registry.get_entry(name) is not entry or _entry_metadata(entry)!=self.metadata[name]:
+                _fail('registered entry changed: '+name)
+        handlers = {'factory_repo_map':readonly.handle_map,'factory_repo_read':readonly.handle_read,
+                    'factory_repo_search':readonly.handle_search}
+        if self.profile=='reviewer-gpt':
+            from tools import kanban_tools
+            handlers.update(factory_review_approve=guard._handle_review_approve,
+                            kanban_show=kanban_tools._handle_show,
+                            kanban_request_changes=kanban_tools._handle_request_changes)
+        for name,handler in handlers.items():
+            if self.entries[name].handler is not handler:
+                _fail('approved handler identity mismatch: '+name)
+        for entry in registry.get_all_entries():
+            if entry.toolset=='kanban' and entry.name not in MODEL_TOOLS[self.profile]:
+                if entry.handler is not guard._disabled_kanban_handler or entry.check_fn is not guard._never_available:
+                    _fail('scoped Kanban restriction absent: '+entry.name)
+
+
+def before_profile_init(profile: str, enabled: Any, disabled: Any, *, provider: Any = None) -> ProfileStartProof:
+    from factory_worker_start import WorkerStartError, _entry_metadata
+    try:
+        home=_sources(profile)
+        from factory_model_boundary import is_moa_provider
+        if is_moa_provider(provider):
+            _fail('MoA route is unsupported for the protected profile')
+        _identity(profile,home)
+        _configuration(profile,enabled,disabled)
+        # Prywatna tablica zadania: hook one-start przed pierwszym narzędziem.
+        from factory_one_start import install_for_worker
+        install_for_worker()
+        from tools import kanban_tools  # noqa: F401
+        from hermes_cli.plugins import discover_plugins,get_plugin_manager
+        from tools.registry import registry
+        discover_plugins()
+        manager=get_plugin_manager()
+        loaded=tuple(manager._plugins.get(n) for n in (GUARD,READONLY))
+        if any(x is None or not x.enabled or x.error or x.module is None for x in loaded):
+            _fail('required plugins unavailable')
+        entries={n:registry.get_entry(n) for n in MODEL_TOOLS[profile]}
+        if any(e is None for e in entries.values()): _fail('required tool unavailable')
+        binding_names = ('HOME', 'HERMES_HOME', 'HERMES_PROFILE', 'HERMES_KANBAN_TASK',
+                         'HERMES_KANBAN_BOARD', 'HERMES_KANBAN_RUN_ID', 'HERMES_KANBAN_WORKSPACE',
+                         'HERMES_KANBAN_HOME', 'HERMES_KANBAN_CLAIM_LOCK', 'FACTORY_RELEASE_TASK', 'FACTORY_RELEASE_WORKSPACE')
+        proof=ProfileStartProof(profile,home,manager,loaded,entries,
+             {n:_entry_metadata(e) for n,e in entries.items()},tuple(enabled),tuple(disabled),os.getpid(),
+             registry,loaded[0].module,loaded[1].module,
+             tuple((k,os.environ.get(k)) for k in binding_names))
+        proof.verify()
+        return proof
+    except WorkerStartError:
+        raise
+    except Exception as exc:
+        raise WorkerStartError('FACTORY_PROFILE_START_REFUSED: '+type(exc).__name__) from exc
+
+
+def after_profile_init(proof: ProfileStartProof, agent: Any) -> None:
+    """Odmów nowej/utraconej definicji; nie przycinaj nadmiarowej powierzchni."""
+    from factory_worker_start import WorkerStartError, _json
+    try:
+        from tools.registry import registry
+        from tools.schema_sanitizer import sanitize_tool_schemas
+        proof.verify()
+        from factory_model_boundary import is_moa_provider
+        if is_moa_provider(getattr(agent, 'provider', None)):
+            _fail('MoA route is unsupported for the protected profile')
+        expected=MODEL_TOOLS[proof.profile]
+        if type(agent.tools) is not list:
+            _fail('invalid model definitions')
+        names=[t['function']['name'] for t in agent.tools]
+        if len(names)!=len(expected) or set(names)!=expected or agent.valid_tool_names!=expected:
+            _fail('profile model capability surface mismatch')
+        reference=sanitize_tool_schemas(registry.get_definitions(set(expected),quiet=True))
+        index={t['function']['name']:_json(t) for t in reference}
+        if set(index)!=expected or any(index[t['function']['name']]!=_json(t) for t in agent.tools):
+            _fail('profile model schema mismatch')
+        proof.verify()
+    except WorkerStartError:
+        raise
+    except Exception as exc:
+        raise WorkerStartError('FACTORY_PROFILE_START_REFUSED: '+type(exc).__name__) from exc
